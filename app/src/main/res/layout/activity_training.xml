<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomNav"
        android:fillViewport="true"
        android:importantForAccessibility="no">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:importantForAccessibility="no">

            <LinearLayout
                android:id="@+id/ll_training_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:focusable="true"
                android:contentDescription="훈련 선택"
                android:importantForAccessibility="yes">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="훈련 "
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="선택"
                    android:textColor="#5CF387"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no" />

                <ImageButton
                    android:id="@+id/btnSetting"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/settings"
                    android:background="@drawable/circle_green"
                    app:tint="@android:color/white"
                    android:contentDescription="설정"
                    android:importantForAccessibility="yes" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_label_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_training_header"
                android:layout_marginTop="30dp"
                android:text="훈련 선택"
                android:textColor="#FF8C00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/ll_training_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_label_select"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:importantForAccessibility="no">

                <LinearLayout
                    android:id="@+id/btn_start_batting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/bg_card_batting"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:contentDescription="타격 훈련 시작. SET, READY, PITCH">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_rounded_green"
                        android:padding="15dp"
                        android:src="@drawable/ic_baseball"
                        android:importantForAccessibility="no"
                        app:tint="#0A0A0A" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:importantForAccessibility="no">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="타격 훈련"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SET · READY · PITCH"
                            android:textColor="#5CF387"
                            android:textSize="13sp"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_start_defense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="110dp"
                    android:layout_marginBottom="35dp"
                    android:background="@drawable/bg_card_defense"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:importantForAccessibility="yes"
                    android:contentDescription="수비 훈련 시작. 3D 음향 포구 훈련">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_rounded_blue"
                        android:padding="15dp"
                        android:src="@drawable/ic_shield"
                        android:importantForAccessibility="no"
                        app:tint="#0A0A0A" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:importantForAccessibility="no">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수비 훈련"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3D 음향 포구 훈련"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_label_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_training_cards"
                android:text="최근 기록"
                android:textColor="#FF8C00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_label_recent"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:importantForAccessibility="no">

                <LinearLayout
                    android:id="@+id/rl_bat_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    android:orientation="vertical"
                    android:importantForAccessibility="yes"
                    android:contentDescription="타격 훈련 최근 기록">

                    <TextView
                        android:id="@+id/tv_rec_bat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="타격 훈련"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_bat_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="5dp"
                        android:text="기록 없음"
                        android:textColor="#5CF387"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:importantForAccessibility="no" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1A1A1A"
                    android:layout_marginBottom="25dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/rl_def_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:importantForAccessibility="yes"
                    android:contentDescription="수비 훈련 최근 기록">

                    <TextView
                        android:id="@+id/tv_rec_def"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="수비 훈련"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_def_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="5dp"
                        android:text="기록 없음"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4"
                        android:importantForAccessibility="no" />

                </LinearLayout>

            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:layout_alignParentBottom="true"
        android:background="#0D0D0D"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:elevation="10dp"
        android:importantForAccessibility="no">

        <!-- ✅ 홈 아이콘 하얀색으로 변경 -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:contentDescription="홈 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_red"
                android:backgroundTint="#441111"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTraining"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:contentDescription="훈련 선택 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_green_vivid"
                android:padding="8dp"
                android:src="@drawable/training"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="훈련"
                android:textColor="#5CF387"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:contentDescription="내 기록 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_orange_dark"
                android:padding="8dp"
                android:src="@drawable/baseline_person_24"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 기록"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>