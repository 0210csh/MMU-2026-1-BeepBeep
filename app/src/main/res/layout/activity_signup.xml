<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0A0A0A"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 헤더 -->
        <LinearLayout
            android:id="@+id/ll_signup_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp"
            android:orientation="horizontal"
            android:contentDescription="회원가입 화면"
            android:importantForAccessibility="yes"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="회원"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="가입"
                android:textColor="#5CF387"
                android:textSize="36sp"
                android:textStyle="bold"
                android:importantForAccessibility="no"/>
        </LinearLayout>

        <!-- 이름 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="이름"
            android:textColor="#5CF387"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>

        <!-- 이름 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/account"
                android:importantForAccessibility="no"
                app:tint="#555555"/>

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@null"
                android:hint="이름을 입력하세요"
                android:contentDescription="이름 입력"
                android:textColor="#000000"
                android:textColorHint="#767676"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 아이디 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="아이디"
            android:textColor="#5CF387"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>

        <!-- 아이디 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_mail_24"
                android:importantForAccessibility="no"
                app:tint="#555555"/>

            <EditText
                android:id="@+id/et_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@null"
                android:hint="영문 소문자·숫자·-·_ 5~20자"
                android:contentDescription="아이디 입력"
                android:textColor="#000000"
                android:textColorHint="#767676"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 이메일 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="이메일"
            android:textColor="#5CF387"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>

        <!-- 이메일 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_mail_24"
                android:importantForAccessibility="no"
                app:tint="#555555"/>

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@null"
                android:hint="비밀번호 재설정에 사용할 이메일을 입력하세요"
                android:contentDescription="이메일 입력"
                android:inputType="textEmailAddress"
                android:textColor="#000000"
                android:textColorHint="#767676"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 비밀번호 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="비밀번호"
            android:textColor="#5CF387"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>

        <!-- 비밀번호 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_white_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_lock_24"
                android:importantForAccessibility="no"
                app:tint="#F06292"/>

            <EditText
                android:id="@+id/et_pw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@null"
                android:hint="8~32자, 영문/숫자/특수문자 중 2가지 이상"
                android:contentDescription="비밀번호 입력"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#767676"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 비밀번호 확인 라벨 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp"
            android:text="비밀번호 확인"
            android:textColor="#5CF387"
            android:textSize="16sp"
            android:textStyle="bold"
            android:importantForAccessibility="no"/>

        <!-- 비밀번호 확인 입력 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="65dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_white_rounded_input"
            android:gravity="center_vertical"
            android:paddingHorizontal="15dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_lock_24"
                android:importantForAccessibility="no"
                app:tint="#F06292"/>

            <EditText
                android:id="@+id/et_pw_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="65dp"
                android:background="@null"
                android:hint="비밀번호를 다시 입력하세요"
                android:contentDescription="비밀번호 확인 입력"
                android:inputType="textPassword"
                android:textColor="#000000"
                android:textColorHint="#767676"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 비밀번호 일치 여부: 실시간 알림용 liveRegion 추가 -->
        <TextView
            android:id="@+id/tv_pw_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="12dp"
            android:text=""
            android:textColor="#5CF387"
            android:textSize="12sp"
            android:visibility="gone"
            android:accessibilityLiveRegion="polite"/>

        <!-- 경고 메시지: 즉시 알림용 liveRegion 추가 -->
        <LinearLayout
            android:id="@+id/ll_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/toast_frame"
            android:backgroundTint="#2A1A0A"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/baseline_info_24"
                android:importantForAccessibility="no"
                app:tint="#FF8C00"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="모든 항목을 입력해주세요"
                android:textColor="#FF8C00"
                android:textSize="14sp"
                android:contentDescription="경고: 모든 항목을 입력해주세요"/>
        </LinearLayout>

        <!-- 회원가입 버튼 -->
        <Button
            android:id="@+id/btn_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="75dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#5CF387"
            android:text="회원가입 완료"
            android:contentDescription="회원가입 완료"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"/>

        <!-- 로그인으로 이동 -->
        <TextView
            android:id="@+id/tv_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:text="이미 계정이 있으신가요? 로그인"
            android:contentDescription="이미 계정이 있으신가요? 로그인 화면으로 이동"
            android:textColor="#5CF387"
            android:textSize="15sp"/>

    </LinearLayout>
</ScrollView>