<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1423">

    <!-- 3루 베이스 (좌측) -->
    <FrameLayout
        android:id="@+id/v2Base3Container"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginStart="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/v2Base3Diamond"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:background="@drawable/base_diamond_normal"
            android:rotation="45"/>

        <View
            android:id="@+id/v2Base3Glow"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:layout_gravity="center"
            android:background="@drawable/base_diamond_active"
            android:rotation="45"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/v2TvBase3Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="3루"
            android:textColor="#94A3B8"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- 1루 베이스 (우측) -->
    <FrameLayout
        android:id="@+id/v2Base1Container"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/v2Base1Diamond"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:background="@drawable/base_diamond_normal"
            android:rotation="45"/>

        <View
            android:id="@+id/v2Base1Glow"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:layout_gravity="center"
            android:background="@drawable/base_diamond_active"
            android:rotation="45"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/v2TvBase1Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1루"
            android:textColor="#94A3B8"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- 중앙 공 궤적 뷰 (전체 높이 채움, 두 그래프의 배경) -->
    <com.beepbeep.defense.batting.BallTrackView
        android:id="@+id/v2BallTrackView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container"/>

    <!-- 공 포물선 라이브 그래프 (사용 안 함 — 항상 숨김) -->
    <com.beepbeep.defense.batting.BallParabolaView
        android:id="@+id/v2LiveParabolaView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/v2SwingGraphView"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container"/>

    <!-- 배트 각도 궤적 라이브 그래프 (시작 버튼 시 VISIBLE) -->
    <com.beepbeep.defense.batting.SwingGraphView
        android:id="@+id/v2SwingGraphView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:visibility="gone"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/tvV2Status"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container"/>

    <!-- 상태 텍스트 -->
    <TextView
        android:id="@+id/tvV2Status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="시작 버튼을 눌러주세요"
        android:textColor="#93C5FD"
        android:textSize="12sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/tvV2Result"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container"/>

    <!-- 결과 텍스트 -->
    <TextView
        android:id="@+id/tvV2Result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FACC15"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/bleControlLayout"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container"/>

    <!-- BLE 연결 버튼 + 상태 표시 -->
    <LinearLayout
        android:id="@+id/bleControlLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/pitchControlLayout"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container">

        <Button
            android:id="@+id/btnBleConnect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="배트 센서 연결"
            android:textColor="#64B4FF"
            android:textSize="11sp"
            android:padding="4dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="● 미연결"
            android:textColor="#F87171"
            android:textSize="11sp"
            android:layout_marginStart="8dp"
            android:gravity="start"/>

        <TextView
            android:id="@+id/tvBatteryLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="배터리 --%"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 투구 횟수 설정 + 진행 표시 -->
    <LinearLayout
        android:id="@+id/pitchControlLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBtnRow"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container">

        <Button
            android:id="@+id/btnSwingPitchMinus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="−"
            android:textColor="#64B4FF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <TextView
            android:id="@+id/tvSwingPitchCount"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnSwingPitchPlus"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="+"
            android:textColor="#64B4FF"
            android:textSize="14sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>

        <TextView
            android:id="@+id/tvSwingPitchProgress"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="end"/>
    </LinearLayout>

    <!-- 하단 버튼 행 -->
    <LinearLayout
        android:id="@+id/bottomBtnRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/v2Base3Container"
        app:layout_constraintEnd_toStartOf="@id/v2Base1Container">

        <Button
            android:id="@+id/btnResultView"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="결과 보기"
            android:textSize="13sp"
            android:textColor="#64B4FF"
            android:padding="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnV2Start"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="시작"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            android:elevation="4dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
