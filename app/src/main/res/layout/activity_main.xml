<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- 상단 점수/상태 -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="성공: 0 / 0"
            android:textColor="#50DC64"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvPhase"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:text="시작 버튼을 누르세요"
            android:textColor="#64B4FF"
            android:textSize="15sp"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[◀ ▶]"
                android:textColor="#64B4FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <Spinner
                android:id="@+id/spinnerDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/difficulty_levels"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 경기장 시각화 -->
    <com.beepbeep.defense.FieldView
        android:id="@+id/fieldView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/tvDebug"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- 디버그 텍스트 -->
    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="준비 완료"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#161B22"
        app:layout_constraintBottom_toTopOf="@id/controlLayout"/>

    <!-- 🎮 컨트롤러 디버그 스위치 -->
    <LinearLayout
        android:id="@+id/debugControllerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#33FFFFFF"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlLayout"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮"
            android:textSize="10sp"/>

        <Switch
            android:id="@+id/switchFakeController"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.7"
            android:scaleY="0.7"/>
    </LinearLayout>

    <!-- 하단 컨트롤 -->
    <LinearLayout
        android:id="@+id/controlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 조이스틱 -->
        <com.beepbeep.defense.JoystickView
            android:id="@+id/joystickView"
            android:layout_width="150dp"
            android:layout_height="150dp"/>

        <!-- 버튼들 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:gravity="center">

            <!-- [X] 시작 + 공 개수 행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[X]"
                    android:textColor="#64B4FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="4dp"/>

                <!-- ✅ 시작 버튼 수정 -->
                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:text="▶ 시작"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="#64B4FF"
                    android:textColor="#0D1117"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"/>

                <Button
                    android:id="@+id/btnBallCountDown"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:text="−"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2D333B"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginStart="6dp"/>

                <TextView
                    android:id="@+id/tvBallCount"
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <Button
                    android:id="@+id/btnBallCountUp"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2D333B"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개"
                    android:textColor="#8B949E"
                    android:textSize="12sp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>

            <!-- [A] CATCH 행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[A]"
                    android:textColor="#50DC64"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnCatch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="60dp"
                    android:text="🤜 CATCH!"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:backgroundTint="#50DC64"
                    android:textColor="#0D1117"
                    android:enabled="false"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>