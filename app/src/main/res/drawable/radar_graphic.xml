<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#334FC3F7"
                android:dashWidth="4dp"
                android:dashGap="4dp" />
            <size android:width="250dp" android:height="250dp" />
        </shape>
    </item>

    <item android:top="40dp" android:bottom="40dp" android:left="40dp" android:right="40dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#334FC3F7"
                android:dashWidth="4dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <item android:top="80dp" android:bottom="80dp" android:left="80dp" android:right="80dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#334FC3F7"
                android:dashWidth="4dp"
                android:dashGap="4dp" />
        </shape>
    </item>

    <item android:top="125dp" android:bottom="125dp">
        <shape android:shape="rectangle">
            <solid android:color="#404FC3F7" />
            <size android:height="1dp" />
        </shape>
    </item>

    <item android:left="125dp" android:right="125dp">
        <shape android:shape="rectangle">
            <solid android:color="#404FC3F7" />
            <size android:width="1dp" />
        </shape>
    </item>

</layer-list>