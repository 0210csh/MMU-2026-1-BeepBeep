<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomNav"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/ll_record_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:contentDescription="내 기록 화면"
                android:importantForAccessibility="yes"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 "
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="기록"
                    android:textColor="#5CF387"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:importantForAccessibility="no" />

                <ImageButton
                    android:id="@+id/btnSetting"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/settings"
                    android:background="@drawable/circle_green"
                    app:tint="@android:color/white"
                    android:contentDescription="설정"
                    android:importantForAccessibility="yes" />
            </LinearLayout>

            <!-- 프로필 -->
            <LinearLayout
                android:id="@+id/ll_user_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_below="@id/ll_record_header"
                android:layout_marginTop="20dp"
                android:background="#1A1A1A"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_circle_gray"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_person_24"
                    android:importantForAccessibility="no"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="로그인이 필요합니다"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 타격 훈련 통계 -->
            <TextView
                android:id="@+id/tv_batting_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/ll_user_profile"
                android:layout_marginTop="30dp"
                android:text="⚾ 타격 훈련 통계"
                android:contentDescription="타격 훈련 통계"
                android:textColor="#5CF387"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_batting_label"
                android:layout_marginTop="6dp"
                android:text="기록 없음"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <GridLayout
                android:id="@+id/statsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvStatCount"
                android:layout_marginTop="10dp"
                android:columnCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatBattingAvg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#00FF7F"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="타율"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatReaction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFB74D"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="반응속도 평균"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatHit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#5CF387"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="정타 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatFoul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FBBF24"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="파울 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatStrike"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#F87171"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스트라이크 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatBaseCorrectPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#4FC3F7"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="베이스 정답률"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvStatBaseCorrect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#A78BFA"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="베이스 정답수 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

            </GridLayout>

            <!-- 수비 훈련 통계 -->
            <TextView
                android:id="@+id/tv_defense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/statsGrid"
                android:layout_marginTop="30dp"
                android:text="🛡 수비 훈련 통계"
                android:contentDescription="수비 훈련 통계"
                android:textColor="#38BDF8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDefenseStatCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_defense_label"
                android:layout_marginTop="6dp"
                android:text="기록 없음"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <GridLayout
                android:id="@+id/defenseStatsGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvDefenseStatCount"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="40dp"
                android:columnCount="2">

                <!-- 성공률 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvDefenseStatSuccessRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#38BDF8"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성공률"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 반응속도 평균 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvDefenseStatReaction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#FFB74D"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="반응속도 평균"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 성공횟수 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvDefenseStatSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#5CF387"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성공횟수 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ✅ 실패횟수 추가 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvDefenseStatFail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="#F87171"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="실패횟수 (평균)"
                        android:textColor="#8F8F8F"
                        android:textSize="12sp" />
                </LinearLayout>

            </GridLayout>

        </RelativeLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:layout_alignParentBottom="true"
        android:background="#0D0D0D"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="홈 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_red"
                android:backgroundTint="#441111"
                android:padding="8dp"
                android:src="@drawable/ic_home"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홈"
                android:textColor="#FF6B6B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTraining"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="훈련 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_green_dark"
                android:padding="8dp"
                android:src="@drawable/training"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="훈련"
                android:textColor="#5CF387"
                android:textSize="12sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="내 기록 화면으로 이동">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/bg_nav_yellow_vivid"
                android:padding="8dp"
                android:src="@drawable/baseline_person_24"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 기록"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>